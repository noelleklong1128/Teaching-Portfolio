.badge.planned .tile svg { filter: grayscale(1); opacity: 0.55; }

/* ---------- contact ---------- */
.save { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: clamp(1.25rem, 4vw, 2.5rem); align-items: center; padding: clamp(1.5rem, 4vw, 2.6rem); background: var(--sun); color: #231F47; border: 0; border-radius: 28px; }
.save .tile { width: 132px; height: 132px; background: #fff; border-radius: 50%; }
