<style>
/* Layout: a calm, painterly one-pager for a new special educator. The owl sits dead center in the hero, with the headline above and the intro below. Then About, Skills, Experience, Toolkit, Credentials and Contact. Smooth vector art and soft watercolor color carry the art theme. */
:root {
  --bg: #F7F6FC;
  --surface: #FFFFFF;
  --surface-2: #EFEBFB;
  --ink: #231F47;
  --muted: #55517E;
  --edge: #D4CEEE;
  --line: #2B2650;
  --shade: rgba(35, 31, 71, 0.32);
  --coral: #F2705F;
  --teal: #1F9D8F;
  --sun: #F7C04A;
  --violet: #6E56CF;
  --sky: #4DA3E8;
  --link: #4B35C4;
  --mark: rgba(247, 192, 74, 0.85);
  --on-accent: #231F47;
  --focus: #4B35C4;
  --blob-a: #F2705F;
  --blob-b: #4DA3E8;
  --blob-c: #F7C04A;

  --font-display: "Bricolage Grotesque", "Trebuchet MS", system-ui, sans-serif;
  --font-body: "Atkinson Hyperlegible", "Segoe UI", system-ui, sans-serif;
  --font-hand: "Caveat", "Segoe Print", "Bradley Hand", cursive;
}
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    --bg: #15122B;
    --surface: #1F1B40;
    --surface-2: #2B2658;
    --ink: #F3F0FF;
    --muted: #B4AEDA;
    --edge: #3F3980;
    --line: #BDB4FF;
    --shade: rgba(0, 0, 0, 0.55);
    --coral: #FF8A7A;
    --teal: #3CCFBF;
    --sun: #FFD36B;
    --violet: #A596FF;
    --sky: #7CC0F5;
    --link: #BDB1FF;
    --mark: rgba(165, 150, 255, 0.42);
    --focus: #FFD36B;
    --blob-a: #FF8A7A;
    --blob-b: #7CC0F5;
    --blob-c: #A596FF;
    color-scheme: dark;
  }
}
:root[data-theme="dark"] {
  --bg: #15122B;
  --surface: #1F1B40;
  --surface-2: #2B2658;
  --ink: #F3F0FF;
  --muted: #B4AEDA;
  --edge: #3F3980;
  --line: #BDB4FF;
  --shade: rgba(0, 0, 0, 0.55);
  --coral: #FF8A7A;
  --teal: #3CCFBF;
  --sun: #FFD36B;
  --violet: #A596FF;
  --sky: #7CC0F5;
  --link: #BDB1FF;
  --mark: rgba(165, 150, 255, 0.42);
  --focus: #FFD36B;
  --blob-a: #FF8A7A;
  --blob-b: #7CC0F5;
  --blob-c: #A596FF;
  color-scheme: dark;
}

* { box-sizing: border-box; }
html { scroll-behavior: smooth; }
body {
  margin: 0;
  background: var(--bg);
  color: var(--ink);
  font-family: var(--font-body);
  font-size: 1.0625rem;
  line-height: 1.65;
  padding-left: max(16px, env(safe-area-inset-left, 0px));
  padding-right: max(16px, env(safe-area-inset-right, 0px));
}
body::before {
  content: "";
  position: fixed;
  inset: 0 0 auto;
  height: env(safe-area-inset-top, 0px);
  z-index: 10;
  background: var(--bg);
}
h1, h2, h3, p, dl, dd, ul { margin: 0; }
h1, h2, h3 { font-family: var(--font-display); text-wrap: balance; line-height: 1.08; letter-spacing: -0.015em; }
a { color: var(--link); }
:focus-visible { outline: 3px solid var(--focus); outline-offset: 3px; }
.wrap { max-width: 1080px; margin-inline: auto; }

/* ---------- nav ---------- */
.hud {
  position: sticky;
  top: env(safe-area-inset-top, 0px);
  z-index: 20;
  margin-inline: calc(-1 * max(16px, env(safe-area-inset-left, 0px)));
  padding-left: max(16px, env(safe-area-inset-left, 0px));
  padding-right: max(16px, env(safe-area-inset-right, 0px));
  background: var(--bg);
  border-bottom: 1.5px solid var(--edge);
}
.hud-inner { max-width: 1080px; margin-inline: auto; display: flex; align-items: center; gap: 1rem; padding-block: 0.6rem; }
.brand { display: flex; align-items: center; gap: 0.6rem; font-family: var(--font-display); font-weight: 800; font-size: 1.1rem; color: var(--ink); text-decoration: none; white-space: nowrap; }
.brand svg { width: 30px; height: auto; flex: none; }
.hud nav { margin-left: auto; min-width: 0; overflow-x: auto; scrollbar-width: none; }
.hud nav::-webkit-scrollbar { display: none; }
.hud ul { list-style: none; padding: 0; display: flex; gap: 0.2rem; }
.hud nav a { display: block; padding: 0.35rem 0.8rem; border-radius: 999px; font-weight: 700; font-size: 0.95rem; color: var(--ink); text-decoration: none; white-space: nowrap; }
.hud nav a:hover { background: var(--sun); color: var(--on-accent); }

/* ---------- shared ---------- */
section { padding-block: clamp(2.5rem, 6vw, 4.5rem); scroll-margin-top: 3.5rem; }
.sec-head { display: grid; gap: 0.5rem; margin-bottom: 1.75rem; }
.eyebrow { display: inline-flex; align-items: center; gap: 0.55rem; font-weight: 700; font-size: 0.85rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted); }
.eyebrow::before { content: ""; width: 12px; height: 12px; border-radius: 50%; background: var(--coral); flex: none; }
h2 { font-size: clamp(1.9rem, 4.2vw, 2.8rem); font-weight: 800; font-stretch: 88%; }
.panel { background: var(--surface); border: 1.5px solid var(--edge); border-radius: 22px; box-shadow: 0 14px 30px -20px var(--shade); }
.chip { display: inline-block; font-weight: 700; font-size: 0.8rem; letter-spacing: 0.06em; text-transform: uppercase; padding: 0.15rem 0.65rem; border-radius: 999px; background: var(--surface-2); color: var(--ink); white-space: nowrap; }
.chip.coral { background: var(--coral); color: var(--on-accent); }
.chip.teal { background: var(--teal); color: var(--on-accent); }
.chip.sun { background: var(--sun); color: var(--on-accent); }
.chip.ghost { background: transparent; box-shadow: inset 0 0 0 1.5px var(--edge); }
.chip.dash { background: transparent; box-shadow: inset 0 0 0 1.5px var(--muted); }
.btn { display: inline-flex; align-items: center; gap: 0.5rem; font-family: var(--font-body); font-weight: 700; font-size: 1.05rem; padding: 0.7rem 1.3rem; border: 0; border-radius: 14px; background: var(--surface-2); color: var(--ink); text-decoration: none; cursor: pointer; box-shadow: 0 4px 0 var(--shade); transition: transform 0.12s ease, box-shadow 0.12s ease; }
.btn:hover { transform: translateY(-2px); box-shadow: 0 6px 0 var(--shade); }
.btn:active { transform: translateY(3px); box-shadow: 0 1px 0 var(--shade); }
.btn.primary { background: var(--coral); color: var(--on-accent); }
.btn.secondary { background: var(--sun); color: var(--on-accent); }
.tile { display: grid; place-items: center; background: #EFEBFF; border-radius: 18px; flex: none; }
.tile svg { display: block; }

/* fixed-color illustration classes (art stays the same in both themes) */
.i-line { fill: none; stroke: #2B2650; stroke-width: 2.6; stroke-linecap: round; stroke-linejoin: round; }
.f-coral { fill: #F2705F; } .f-teal { fill: #25B3A5; } .f-sun { fill: #F7C04A; } .f-violet { fill: #7B63E8; }
.f-sky { fill: #6BB7F0; } .f-white { fill: #FFFFFF; } .f-ink { fill: #2B2650; stroke: #2B2650; }

/* ---------- hero (centered) ---------- */
.hero { position: relative; isolation: isolate; display: grid; justify-items: center; text-align: center; gap: clamp(1.25rem, 3vw, 1.9rem); padding-block: clamp(2rem, 5vw, 4rem); }
.blobs { position: absolute; inset: 0; z-index: -1; overflow: hidden; pointer-events: none; }
.blobs svg { width: 100%; height: 100%; display: block; }
.hero-tags { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.5rem; }
h1 { font-size: clamp(2.4rem, 6.2vw, 4.4rem); font-weight: 800; font-stretch: 85%; line-height: 1; letter-spacing: -0.025em; max-width: 20ch; }
.mark { background: linear-gradient(transparent 58%, var(--mark) 58% 90%, transparent 90%); border-radius: 0.25em 0.6em 0.35em 0.7em; padding-inline: 0.1em; box-decoration-break: clone; -webkit-box-decoration-break: clone; }
.lead { max-width: 54ch; font-size: 1.15rem; }
.lead b { font-weight: 700; }
.hero-cta { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.9rem; }

.window { overflow: hidden; min-width: 0; width: min(100%, 760px); }
.scene { position: relative; line-height: 0; }
.scene svg { width: 100%; height: auto; display: block; }
.lbl { font-family: var(--font-body); font-weight: 700; fill: #2B2650; }
.owl { animation: bob 3.2s ease-in-out infinite; }
@keyframes bob { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-3px); } }
.owl.hop { animation: hop 0.55s ease-out 1; }
@keyframes hop { 0% { transform: translateY(0); } 35% { transform: translateY(-16px); } 70% { transform: translateY(0); } 85% { transform: translateY(-4px); } 100% { transform: translateY(0); } }
.twinkle { animation: twinkle 2.6s ease-in-out infinite; transform-box: fill-box; transform-origin: center; }
@keyframes twinkle { 0%, 100% { transform: scale(1); opacity: 1; } 50% { transform: scale(0.7); opacity: 0.7; } }
.bubble { position: absolute; left: 30%; bottom: 56%; width: 40%; padding: 0.45rem 0.65rem; background: #fff; color: #2B2650; border: 2.5px solid #2B2650; border-radius: 14px; font-family: var(--font-body); font-weight: 700; font-size: clamp(0.66rem, 1.9vw, 0.98rem); line-height: 1.25; text-align: center; cursor: pointer; }
.bubble::after { content: ""; position: absolute; left: 50%; bottom: -9px; margin-left: -6px; width: 11px; height: 11px; background: #fff; border-right: 2.5px solid #2B2650; border-bottom: 2.5px solid #2B2650; transform: rotate(45deg); }
.owl-hit { position: absolute; left: 35%; top: 46.7%; width: 30%; height: 49.8%; background: transparent; border: 0; padding: 0; cursor: pointer; border-radius: 40%; }
.owl-hit:focus-visible { outline: 3px solid var(--focus); outline-offset: 0; }
.hint { font-family: var(--font-hand); font-weight: 700; font-size: 1.35rem; line-height: 1; color: var(--muted); padding: 0.6rem 1rem 0.7rem; text-align: center; background: var(--surface); }

/* ---------- about ---------- */
.about { display: grid; grid-template-columns: minmax(0, 1fr); gap: clamp(1.75rem, 4vw, 2.75rem); }
.about-copy { display: grid; gap: 1.25rem; text-align: left; min-width: 0; }
.sheet { padding: 1.3rem 1.5rem 1.5rem; min-width: 0; }
.sheet h3 { font-size: 1.25rem; font-weight: 800; margin-bottom: 1rem; }
.sheet dl { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.75rem 2.5rem; }
.sheet dl div { display: grid; grid-template-columns: 6.5rem minmax(0, 1fr); gap: 0.75rem; align-items: baseline; padding-top: 0.75rem; border-top: 1.5px dashed var(--edge); }
.sheet dt { font-weight: 700; font-size: 0.8rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted); }
.sheet dd { font-weight: 700; line-height: 1.35; }
.beliefs { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.25rem; margin-top: 2.25rem; }
.belief { padding: 1.25rem 1.3rem 1.4rem; display: grid; gap: 0.75rem; align-content: start; min-width: 0; }
.belief h3 { font-size: 1.35rem; font-weight: 800; }
.belief p { color: var(--muted); line-height: 1.55; }
.belief .tile { width: 60px; height: 60px; border-radius: 16px; }

/* ---------- skills ---------- */
.stats { padding: clamp(1.2rem, 3vw, 1.9rem); display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.6rem clamp(1.5rem, 4vw, 3rem); }
.stat { display: grid; gap: 0.4rem; min-width: 0; }
.stat-top { display: flex; align-items: center; justify-content: space-between; gap: 0.5rem 0.75rem; flex-wrap: wrap; }
.stat h3 { font-size: 1.2rem; font-weight: 800; letter-spacing: -0.005em; }
.stat-tags { display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap; }
.pips { display: flex; gap: 6px; }
.pip { width: 14px; height: 14px; border-radius: 50%; background: var(--surface-2); }
.pip.on { background: var(--pip, var(--coral)); }
.stat p { color: var(--muted); line-height: 1.5; }
.stats-foot { grid-column: 1 / -1; font-family: var(--font-hand); font-weight: 700; font-size: 1.35rem; line-height: 1.2; color: var(--muted); }

/* ---------- experience ---------- */
.quests { display: grid; gap: 1.4rem; }
.quest { display: grid; grid-template-columns: 11rem minmax(0, 1fr); gap: 0.5rem 1.75rem; padding: 1.4rem 1.6rem 1.5rem; }
.quest-meta { display: flex; flex-direction: column; align-items: flex-start; gap: 0.55rem; min-width: 0; }
.quest-when { font-weight: 700; color: var(--muted); line-height: 1.3; }
.quest-body { display: grid; gap: 0.5rem; min-width: 0; }
.quest h3 { font-size: 1.5rem; font-weight: 800; }
.quest-place { font-weight: 700; color: var(--link); }
.quest p { max-width: 62ch; }
.loot { display: flex; flex-wrap: wrap; gap: 0.5rem; align-items: center; margin-top: 0.4rem; }
.loot-label { font-weight: 700; font-size: 0.8rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); margin-right: 0.25rem; }

.duties { list-style: none; padding: 0; display: grid; gap: 0.6rem; max-width: 64ch; margin-block: 0.3rem 0.2rem; }
.duties li { display: grid; grid-template-columns: 14px minmax(0, 1fr); gap: 0.7rem; align-items: start; line-height: 1.5; }
.duties li::before { content: ""; width: 10px; height: 10px; margin-top: 0.5em; border-radius: 50%; background: var(--teal); }

/* ---------- lesson plans ---------- */
.lessons-intro { max-width: 58ch; margin-bottom: 1.5rem; }
.plans { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr)); gap: 1.4rem; }
.plan { padding: 1.4rem 1.4rem 1.5rem; display: flex; flex-direction: column; gap: 1.1rem; min-width: 0; }
.plan-head { display: flex; align-items: center; gap: 0.9rem; min-width: 0; }
.plan-head .tile { width: 60px; height: 60px; border-radius: 16px; }
.plan-head > div:last-child { display: grid; gap: 0.5rem; min-width: 0; }
.plan h3 { font-size: 1.35rem; font-weight: 800; }
.plan-meta { display: flex; flex-wrap: wrap; gap: 0.4rem; }
.plan dl { display: grid; gap: 0.75rem; margin-bottom: auto; }
.plan dl div { display: grid; gap: 0.2rem; padding-top: 0.75rem; border-top: 1.5px dashed var(--edge); }
.plan dt { font-weight: 700; font-size: 0.8rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted); }
