footer { padding-block: 2rem 2.5rem; color: var(--muted); display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 0.75rem 1.5rem; font-size: 0.95rem; }
.swatches { display: flex; gap: 6px; }
