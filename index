<main class="wrap" id="top">

  <div class="hero">
    <div class="blobs" aria-hidden="true">
      <svg viewBox="0 0 800 560" preserveAspectRatio="xMidYMid slice">
        <defs><filter id="soft" x="-30%" y="-30%" width="160%" height="160%"><feGaussianBlur stdDeviation="38"/></filter></defs>
        <g filter="url(#soft)" opacity="0.32">
          <circle cx="90" cy="110" r="120" fill="var(--blob-c)"/>
          <circle cx="720" cy="150" r="150" fill="var(--blob-b)"/>
